# Required in production. Development defaults match compose.yaml.
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional: key for encrypting connector secrets at rest (>=32 chars). Defaults to BETTER_AUTH_SECRET.
APP_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:3000

# At least one sign-in provider should be configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional SMTP-delivered magic links. Enable only with complete Email settings.
MAGIC_LINK_ENABLED=false
# Configurable display name. Server: APP_NAME (auth, emails); client: VITE_APP_NAME.
APP_NAME=LedgerCatch
VITE_APP_NAME=LedgerCatch

# Optional Email: lazy unless used or magic links are enabled. Never logs messages.
# Local Mailpit: start explicitly with demo:setup; no forwarding/relay.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_REPLY_TO_NAME=
EMAIL_MAX_RECIPIENTS=50

# Optional Compose overrides for host ports and the shared application image.
APP_PORT=3000
POSTGRES_PORT=5432
APP_IMAGE=ledgercatch:local

# PostgreSQL-backed jobs use DATABASE_URL unless a separate URL is supplied.
PGBOSS_DATABASE_URL=
PGBOSS_SCHEMA=pgboss
PGBOSS_USE_LISTEN_NOTIFY=false
JOBS_CONCURRENCY=4

# Optional server observability. Empty endpoints never contact a default collector.
OTEL_SERVICE_NAME=tanstack-app
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_RESOURCE_ATTRIBUTES=
APP_VERSION=
APP_REVISION=
DEPLOYMENT_ENVIRONMENT=
LOG_LEVEL=info
LOG_REDACT_FIELDS=

# Optional Storage: leave unset until used; no startup bucket mutation/readiness coupling.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SESSION_TOKEN=
STORAGE_FORCE_PATH_STYLE=
STORAGE_PRESIGN_TTL_SECONDS=600
STORAGE_KEY_PREFIX=

# Optional AI: leave absent for normal build/start/health/worker. Configure only on use.
# AI_PROVIDER=openai-compatible
# AI_MODEL=your-explicit-model
# AI_API_KEY=server-only-secret-if-needed
# AI_BASE_URL=https://your-compatible-endpoint.example/v1
# AI_TIMEOUT_SECONDS=60

# Realtime server transport choice: sse (default), websocket, or sse,websocket.
REALTIME_TRANSPORTS=sse
# Privileged platform-wide operational summaries. Empty denies all; server-only IDs.
OPS_ADMIN_USER_IDS=

# Comma-separated emails or @domains allowed to create an account (empty = first user only).
ALLOWED_SIGNUP_EMAILS=

# Optional Notifications ntfy adapter; no public service default. Per-user topics are set in Settings → Notifications.
NTFY_BASE_URL=
NTFY_TOKEN=
NTFY_TIMEOUT_SECONDS=10
# Optional Invoice Ninja capability "default" connection (lazy, server-only, never VITE_*).
# Per-user connections come from Settings → Connections; their webhook secrets are generated in Settings → Notifications.
INVOICE_NINJA_BASE_URL=
INVOICE_NINJA_API_TOKEN=
INVOICE_NINJA_WEBHOOK_SECRET=
INVOICE_NINJA_WEBHOOK_SECRET_PREVIOUS=
# Optional operator-level Webhooks target (targetRef "reference"); user endpoints are configured in the app.
# HTTPS required. Generate a random whsec_ base64 secret using generateWebhookSecret().
WEBHOOK_REFERENCE_URL=
WEBHOOK_REFERENCE_SECRET=
# Allow user webhook endpoints on private/LAN/loopback addresses and plain http (e.g. n8n, Home Assistant). Default false.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Operator-approved custom HTTP origins with pinned addresses. Empty denies all.
# Example: [{"origin":"https://api.example.test","addresses":["203.0.113.10"]}]
CUSTOM_HTTP_ENDPOINTS=[]
