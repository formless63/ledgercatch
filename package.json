{
  "name": "ledgercatch",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.2"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "api-platform:smoke": "bun scripts/api-platform-smoke.ts",
    "observability:smoke": "bun scripts/observability-smoke.ts",
    "storage:check": "bun scripts/storage-check.ts",
    "storage:smoke": "bun scripts/storage-smoke.ts",
    "storage:unit": "bun scripts/storage-unit.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test-isolated.ts",
    "test:e2e": "playwright test",
    "jobs:worker": "bun scripts/jobs-worker.ts",
    "jobs:migrate": "bun scripts/jobs-migrate.ts",
    "jobs:doctor": "bun scripts/jobs-doctor.ts",
    "jobs:smoke": "bun scripts/jobs-smoke.ts",
    "email:check": "bun scripts/email-check.ts",
    "email:smoke": "bun scripts/email-smoke.ts",
    "email:unit": "vitest run src/integrations/email",
    "search:smoke": "bun scripts/search-smoke.ts",
    "audit-log:smoke": "bun scripts/audit-log-smoke.ts",
    "ai:unit": "bun scripts/ai-unit.ts",
    "ai:compat": "bun scripts/ai-compat.ts",
    "realtime:unit": "bun scripts/realtime-unit.ts",
    "webhooks:unit": "bun scripts/webhooks-unit.ts",
    "webhooks:smoke": "bun scripts/webhooks-smoke.ts",
    "notifications:unit": "bun scripts/notifications-unit.ts",
    "notifications:smoke": "bun scripts/notifications-smoke.ts",
    "invoice-ninja:unit": "vitest run src/integrations/invoice-ninja",
    "invoice-ninja:smoke": "bun scripts/invoice-ninja-database-fixture.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "demo:setup": "bun scripts/demo.ts setup",
    "demo:start": "bun scripts/demo.ts start",
    "demo:seed": "bun scripts/demo.ts seed",
    "demo:screenshots": "bun scripts/demo.ts screenshots",
    "test:demo": "bun scripts/demo.ts test",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --maxWorkers=2 --no-file-parallelism",
    "extension:package": "bun scripts/package-extension.ts",
    "build:runtime": "bun run build && bun scripts/bundle-runtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
