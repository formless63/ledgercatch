    "nodemailer": "10.1.4",
    "openai": "7.25.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.3.6",
    "zod": "4.6.6",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.55.0",
    "@scalar/openapi-parser": "^0.29.8",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.38",
    "@testing-library/react": "16.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "crossws": "0.4.12",
    "dotenv": "^17.3.1",
    "jsdom": "30.1.1",
    "typescript": "^6.0.2",
    "vite": "8.3.5",
