{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"jsx": "react-jsx",
		"types": ["vitest/globals"]
	},
	"include": [".wxt/wxt.d.ts", "src", "tests", "scripts", "wxt.config.ts", "vitest.config.ts"]
}
